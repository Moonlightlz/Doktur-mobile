{
  "name": "doktur-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "App de Doktur para pacientes (Android e iOS). Expo SDK 57. Demostración con datos sintéticos.",
  "main": "expo-router/entry",
  "scripts": {
    "sincronizar": "node scripts/sincronizar.mjs",
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "tsc --noEmit && node scripts/sin-colores-literales.mjs",
    "test": "jest",
    "exportar:android": "expo export --platform android --output-dir dist-android --source-maps",
    "auditoria": "node scripts/auditoria.mjs",
    "exportar:ios": "expo export --platform ios --output-dir dist-ios --source-maps",
    "verificar": "npm run check && npm test && npm run auditoria && npm run exportar:android && node scripts/paquetes-en-bundle.mjs && npm run exportar:ios && node scripts/paquetes-en-bundle.mjs dist-ios/_expo/static/js/ios"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/metro-runtime": "57.0.16",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-expo-plugin": "1.0.3",
    "@livekit/react-native-webrtc": "144.2.0",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-keep-awake": "57.0.2",
    "expo-linear-gradient": "57.0.2",
    "expo-linking": "57.0.12",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "livekit-client": "2.22.3",
    "lucide-react-native": "1.52.0",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "babel-preset-expo": "57.0.14",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "typescript": "6.0.3"
  },
  "overrides": {
    "decode-uri-component": "file:./parches/decode-uri-component"
  }
}
